<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>71b2d164-92d5-4e47-b722-93da26a841d7</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>MISMO</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Member 360"/>
  <Description DefaultValue="Log an email to the right company in Member 360: it finds the company and fills in the touchpoint."/>
  <IconUrl DefaultValue="https://resources.mismo.org/member-360/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://resources.mismo.org/member-360/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://resources.mismo.org/member-360/"/>
  <AppDomains>
    <AppDomain>https://resources.mismo.org</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://resources.mismo.org/member-360/?outlook=1"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="m360Group">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="m360Open">
                    <Label resid="ButtonLabel"/>
                    <Supertip>
                      <Title resid="ButtonLabel"/>
                      <Description resid="ButtonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="PaneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://resources.mismo.org/member-360/outlook/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://resources.mismo.org/member-360/outlook/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://resources.mismo.org/member-360/outlook/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="PaneUrl" DefaultValue="https://resources.mismo.org/member-360/?outlook=1"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Member 360"/>
          <bt:String id="ButtonLabel" DefaultValue="Log to Member 360"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTip" DefaultValue="Open Member 360 beside this email. It finds the company and fills in the touchpoint for you to check and save."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
